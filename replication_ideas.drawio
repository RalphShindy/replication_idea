        </mxCell>
        <mxCell id="kGuyq0Opb2z_zTHdiOKp-115" value="&lt;div align=&quot;left&quot;&gt;Server (1) creates data entry&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;ul&gt;&lt;li&gt;Insert data set into table&lt;/li&gt;&lt;li&gt;Insert into replication_state: table_name, related_id, created_at into&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;Server (1) updates data entry&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;ul&gt;&lt;li&gt;Update data set (check if something changed)&lt;/li&gt;&lt;li&gt;Updated replication_state: updated_at column&lt;/li&gt;&lt;/ul&gt;Server (1) deletes data entry&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;ul&gt;&lt;li&gt;Delete data entry&lt;/li&gt;&lt;li&gt;Updated replication_state: deleted_at column&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="260" width="420" height="230" as="geometry" />
        </mxCell>
        <mxCell id="kGuyq0Opb2z_zTHdiOKp-117" value="&lt;div align=&quot;left&quot;&gt;Server (1) replicates state up to Server (2), replication_info with server_id = 2&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Get all replication_state entries where replication_info doesn&#39;t exists&lt;br&gt;&lt;/li&gt;&lt;li&gt;Get all replication_state entries where deleted_at not null and a replication_info exists with synced_at &amp;lt; deleted_at&lt;br&gt;&lt;/li&gt;&lt;li&gt;Get all replication_state entries where updated_at not null and a replication_info exists with synced_at &amp;lt; updated_at and deleted_at is null&lt;/li&gt;&lt;li&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;Send replicate/up/{model}/create with first results&lt;/li&gt;&lt;li&gt;Send replicate/up/{model}/update with second results&lt;/li&gt;&lt;li&gt;Send replicate/up/{model}/delete with third results&lt;/li&gt;&lt;/ul&gt;On Server (2)&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;For first request insert data into model (auto generates replication_state: table_name, related_id, created_at)&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Create replication_info: replication_state_id, server_id (1), synced_at (now)&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;For second request update data sets of model (auto updates replication_state: updated_at)&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Update replication_info: synced_at (now)&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;For third request delete data entries&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Delete replication_info&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;On Server (1)&lt;br&gt;&lt;/div&gt;&lt;ul&gt;&lt;li&gt;If first response is status (204) insert into replication_info: replication_state_id, server_id (2), synced_at (now)&lt;/li&gt;&lt;li&gt;If second response is status (204) update replication_info: synced_at (now)&lt;/li&gt;&lt;li&gt;If third response is status (204) delete replication_info&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="510" width="790" height="390" as="geometry" />
        </mxCell>
        <mxCell id="kGuyq0Opb2z_zTHdiOKp-119" value="&lt;div&gt;Migrate&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Master server gets all relevant data and initiates a /migrate/fresh/... to child server, both ignore replication_info (delete all and create new scoped to server_id)&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;Replicate Up&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Child server gets all relevant data and initiates a /replicate/up/... to master server, uses replication_info&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;Replicate Down&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Child server sends /replicate/down to master server to initiate a /replicate/up/... from master server to child server, uses replication_info&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="910" width="900" height="180" as="geometry" />
        </mxCell>
        <mxCell id="kGuyq0Opb2z_zTHdiOKp-120" value="&lt;div align=&quot;left&quot;&gt;Server (1) = Child&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;Server (2) = Master&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="210" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kGuyq0Opb2z_zTHdiOKp-121" value="&lt;div align=&quot;left&quot;&gt;Routes:&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;/migrate/{model}/fresh - Master only&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;/replicate/down - both&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;/replicate/up/{model}/create - both&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;/replicate/up/{model}/update - both&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;/replicate/up/{model}/delete - both&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="530" y="200" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="kGuyq0Opb2z_zTHdiOKp-123" value="example_scoped_table" style="shape=table;startSize=30;container=1;collapsible=1;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=1;" parent="1" vertex="1">
          <mxGeometry x="530" y="20" width="180" height="150" as="geometry" />
